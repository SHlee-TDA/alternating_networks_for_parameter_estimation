\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Restricted sampled sensitivity of the OGTT model. \emph  {(Left)} The three singular values of the $5\times 3$ Jacobian $\nabla _\xi \mathcal  {G}$, $\xi =(I_0,S_I,\sigma )$, at the five-point grid: locally full rank $3$ but spanning $\sim \!10^3$ (ill-conditioned). \emph  {(Right)} The temporal sensitivity of glucose to $S_I$ and $\sigma $ is nearly identical throughout the window --- the two parameters act on glucose almost interchangeably, so only their stiff combination is well determined.\relax }}{22}{figure.caption.99}\protected@file@percent }
\newlabel{fig:ogtt_sensitivity}{{4}{22}{Restricted sampled sensitivity of the OGTT model. \emph {(Left)} The three singular values of the $5\times 3$ Jacobian $\nabla _\xi \mathcal {G}$, $\xi =(I_0,S_I,\sigma )$, at the five-point grid: locally full rank $3$ but spanning $\sim \!10^3$ (ill-conditioned). \emph {(Right)} The temporal sensitivity of glucose to $S_I$ and $\sigma $ is nearly identical throughout the window --- the two parameters act on glucose almost interchangeably, so only their stiff combination is well determined.\relax }{figure.caption.99}{}}
\newlabel{fig:ogtt_sensitivity@cref}{{[figure][4][]4}{[1][22][]22}}
\citation{ha2025disposition}
\@writefile{toc}{\contentsline {paragraph}{The weak direction is only the HGP symmetry-breaking}{23}{section*.100}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Full ISS-HGP versus constant-HGP ablation of the restricted OGTT sampled Jacobian $\mathbf  {J}=\nabla _\xi \mathcal  {G}\operatorname  {diag}(\xi )$, $\xi =(I_0,S_I,\sigma )$ (central differences, step-size stable). \emph  {(a)} Three-value spectrum at the five-point grid: the smallest singular value drops from $\varsigma _3\approx 0.073$ (full, numerically rank $3$) to $\approx 5\times 10^{-5}$ (constant HGP, analytic rank $\le 2$; a third value at the numerical floor). \emph  {(b)} Sensitivity $\|\mathbf  {J}\hat  t\|$ along the scaling tangent $\hat  t=(+1,-1,+1)/\sqrt  3$ versus number of glucose samples: for the full model it grows with density, while for constant HGP it stays at the numerical floor (exact null). \emph  {(c)} Glucose invariance under the scaling symmetry\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:scaling-symmetry}\unskip \@@italiccorr )}}: constant-HGP glucose is invariant to within numerical tolerance (exact symmetry), whereas the full model breaks it by a sub-percent, $c$-dependent amount --- the origin of the weak, ill-conditioned product-orthogonal direction.\relax }}{23}{figure.caption.101}\protected@file@percent }
\newlabel{fig:ogtt_hgp}{{5}{23}{Full ISS-HGP versus constant-HGP ablation of the restricted OGTT sampled Jacobian $\mathbf {J}=\nabla _\xi \mathcal {G}\operatorname {diag}(\xi )$, $\xi =(I_0,S_I,\sigma )$ (central differences, step-size stable). \emph {(a)} Three-value spectrum at the five-point grid: the smallest singular value drops from $\varsigma _3\approx 0.073$ (full, numerically rank $3$) to $\approx 5\times 10^{-5}$ (constant HGP, analytic rank $\le 2$; a third value at the numerical floor). \emph {(b)} Sensitivity $\|\mathbf {J}\hat t\|$ along the scaling tangent $\hat t=(+1,-1,+1)/\sqrt 3$ versus number of glucose samples: for the full model it grows with density, while for constant HGP it stays at the numerical floor (exact null). \emph {(c)} Glucose invariance under the scaling symmetry~\eqref {eq:scaling-symmetry}: constant-HGP glucose is invariant to within numerical tolerance (exact symmetry), whereas the full model breaks it by a sub-percent, $c$-dependent amount --- the origin of the weak, ill-conditioned product-orthogonal direction.\relax }{figure.caption.101}{}}
\newlabel{fig:ogtt_hgp@cref}{{[figure][5][]5}{[1][23][]23}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Parameter recovery (RMSE\,/\,Pearson $r$) on synthetic test data. The direct baseline recovers well-conditioned parameters nearly perfectly ($r\!\approx \!0.98$); its recovery degrades along the directions the observability analysis flags as rank-deficient or ill-conditioned (LV $\beta $; OGTT $S_I,\sigma $ individually). The iterative estimator converges but exhibits an additional approximation gap even where the problem is well-conditioned (SIR).\relax }}{24}{table.caption.104}\protected@file@percent }

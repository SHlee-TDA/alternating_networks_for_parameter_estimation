\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces OGTT joint-distribution collapse (iterative estimator; the direct baseline is qualitatively identical). \emph  {Left:} predictions (blue) collapse the 2-D ground-truth cloud (grey) onto a 1-D locus. \emph  {Center:} the identifiable product $S_I\sigma $ (stiff direction) is recovered ($r=0.93$). \emph  {Right:} the two individual coordinates $S_I$ and $\sigma $ are both weakly recovered and to the same degree ($r=0.65$ each), neither privileged --- the estimate collapses along the approximate product direction (with an additional off-fiber operator error for the iteration, quantified below). This realizes the regression-to-the-mean of Corollary\nobreakspace  {}\ref  {cor:lower_bound} in the log training coordinate.\relax }}{28}{figure.caption.112}\protected@file@percent }
\newlabel{fig:ogtt-collapse}{{9}{28}{OGTT joint-distribution collapse (iterative estimator; the direct baseline is qualitatively identical). \emph {Left:} predictions (blue) collapse the 2-D ground-truth cloud (grey) onto a 1-D locus. \emph {Center:} the identifiable product $S_I\sigma $ (stiff direction) is recovered ($r=0.93$). \emph {Right:} the two individual coordinates $S_I$ and $\sigma $ are both weakly recovered and to the same degree ($r=0.65$ each), neither privileged --- the estimate collapses along the approximate product direction (with an additional off-fiber operator error for the iteration, quantified below). This realizes the regression-to-the-mean of Corollary~\ref {cor:lower_bound} in the log training coordinate.\relax }{figure.caption.112}{}}
\newlabel{fig:ogtt-collapse@cref}{{[figure][9][]9}{[1][28][]28}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Predictions and the \emph  {product-conditioned arithmetic-mean locus} $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle m$}\mathaccent "0365{m}(c)=\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathbb  {E}$}\mathaccent "0362{\mathbb  {E}}[(S_I,\sigma )\mid S_I\sigma =c]$ in the $(S_I,\sigma )$ plane (shared test split; grey: ground-truth joint, dotted: constant-$S_I\sigma $ fibers, red: $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle m$}\mathaccent "0365{m}(c)$). The red curve is a \emph  {reference geometry}, not the estimators' Bayes target: the network trains in log coordinates, whose on-fiber geometric mean --- not this arithmetic locus --- is its target (Remark\nobreakspace  {}\ref  {rem:coordinate}), and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle m$}\mathaccent "0365{m}(c)$ conditions on the product rather than on $\mathbf  {x}_\mathrm  {obs}$. \emph  {Left:} the iterative fixed point collapses onto a tight $1$-D band, sitting off the fibers by an amount consistent with operator approximation. \emph  {Right:} the matched direct estimator recovers the product and fans \emph  {along} the fibers (near the on-fiber geometric mean). Annotations report per-bin distances and the off-fiber product bias $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle m$}\mathaccent "0365{m}_1\setbox \z@ \hbox {\mathsurround \z@ $\textstyle m$}\mathaccent "0365{m}_2-c$ of the reference locus (positive, the Jensen property of Corollary\nobreakspace  {}\ref  {cor:off_fiber_product} under physical-coordinate averaging).\relax }}{29}{figure.caption.113}\protected@file@percent }
\newlabel{fig:ogtt-condmean}{{10}{29}{Predictions and the \emph {product-conditioned arithmetic-mean locus} $\widetilde m(c)=\widehat {\mathbb {E}}[(S_I,\sigma )\mid S_I\sigma =c]$ in the $(S_I,\sigma )$ plane (shared test split; grey: ground-truth joint, dotted: constant-$S_I\sigma $ fibers, red: $\widetilde m(c)$). The red curve is a \emph {reference geometry}, not the estimators' Bayes target: the network trains in log coordinates, whose on-fiber geometric mean --- not this arithmetic locus --- is its target (Remark~\ref {rem:coordinate}), and $\widetilde m(c)$ conditions on the product rather than on $\mathbf {x}_\mathrm {obs}$. \emph {Left:} the iterative fixed point collapses onto a tight $1$-D band, sitting off the fibers by an amount consistent with operator approximation. \emph {Right:} the matched direct estimator recovers the product and fans \emph {along} the fibers (near the on-fiber geometric mean). Annotations report per-bin distances and the off-fiber product bias $\widetilde m_1\widetilde m_2-c$ of the reference locus (positive, the Jensen property of Corollary~\ref {cor:off_fiber_product} under physical-coordinate averaging).\relax }{figure.caption.113}{}}
\newlabel{fig:ogtt-condmean@cref}{{[figure][10][]10}{[1][29][]29}}
\@writefile{toc}{\contentsline {paragraph}{Physical- versus log-coordinate MSE}{29}{section*.114}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Physical- versus log-coordinate MSE for the direct regressor (one representative seed; grey: ground truth, dotted: constant-$S_I\sigma $ fibers, blue: predictions). Titles report the per-point product error (mDI) and signed product bias. \emph  {Left:} log-coordinate MSE keeps the product on the fiber (bias $\approx 0$). \emph  {Right:} physical-coordinate MSE inflates the product (bias $>0$, the Jensen/convex side of Corollary\nobreakspace  {}\ref  {cor:off_fiber_product}), i.e.\ leaves the fiber --- while individual-coordinate recovery is unchanged. Off-fiber displacement is thus a property of the loss coordinate (Remark\nobreakspace  {}\ref  {rem:coordinate}).\relax }}{30}{figure.caption.115}\protected@file@percent }
\newlabel{fig:ogtt-coord}{{11}{30}{Physical- versus log-coordinate MSE for the direct regressor (one representative seed; grey: ground truth, dotted: constant-$S_I\sigma $ fibers, blue: predictions). Titles report the per-point product error (mDI) and signed product bias. \emph {Left:} log-coordinate MSE keeps the product on the fiber (bias $\approx 0$). \emph {Right:} physical-coordinate MSE inflates the product (bias $>0$, the Jensen/convex side of Corollary~\ref {cor:off_fiber_product}), i.e.\ leaves the fiber --- while individual-coordinate recovery is unchanged. Off-fiber displacement is thus a property of the loss coordinate (Remark~\ref {rem:coordinate}).\relax }{figure.caption.115}{}}
\newlabel{fig:ogtt-coord@cref}{{[figure][11][]11}{[1][30][]30}}

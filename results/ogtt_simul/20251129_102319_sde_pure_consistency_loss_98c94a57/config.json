{
    "EXPERIMENT_NAME": "sde_pure_consistency_loss",
    "USE_SPECTRAL_NORM": false,
    "USE_CONSISTENCY_LOSS": true,
    "MODEL_CONFIG": {
        "f_theta": {
            "hidden_dims": [
                128,
                128,
                128,
                128
            ],
            "activation": "Tanh"
        },
        "g_phi": {
            "hidden_dims": [
                128,
                128,
                128,
                128
            ],
            "activation": "Tanh"
        },
        "initialization": {
            "type": "xavier",
            "distribution": "normal"
        }
    },
    "USE_SDE": true,
    "DEVICE": "cpu"
}